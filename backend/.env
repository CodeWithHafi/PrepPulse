# ============================================================
# PrepPulse Backend – Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="#4ever@Yours"
DB_NAME=preppulse

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS – Frontend URL
CLIENT_URL=http://localhost:5173
